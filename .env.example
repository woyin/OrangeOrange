# 在启动 daemon 前导出变量；不会自动读取 .env 文件。
OPENAI_API_KEY=
# 在线搜索使用 Brave Search API；网页读取不需要此 key。
BRAVE_SEARCH_API_KEY=
ORANGE_MODEL=gpt-4.1-mini
# ORANGE_DATA_DIR=/absolute/path/to/private-data
# ORANGE_WORKSPACE=/absolute/path/to/documents
# ORANGE_SKILLS_DIR=/absolute/path/to/skills
# ORANGE_PROMPTS_DIR=/absolute/path/to/prompts

# Telegram：同时填写 token 与允许的数字用户 ID。
# ORANGE_TELEGRAM_TOKEN=
# ORANGE_TELEGRAM_USERS=
# ORANGE_TELEGRAM_MEMORY_SCOPE=local

# WhatsApp Cloud API：需自行配置公网 HTTPS 回调与受支持的 API 版本。
# ORANGE_WHATSAPP_TOKEN=
# ORANGE_WHATSAPP_PHONE_ID=
# ORANGE_WHATSAPP_API_VERSION=
# ORANGE_WHATSAPP_APP_SECRET=
# ORANGE_WHATSAPP_VERIFY_TOKEN=
# ORANGE_WHATSAPP_USERS=
# ORANGE_WHATSAPP_PORT=8788
# ORANGE_WHATSAPP_MEMORY_SCOPE=local

# 微信：先执行 weixin login，再启用。
# ORANGE_WEIXIN_ENABLED=1
# ORANGE_WEIXIN_USERS=
# ORANGE_WEIXIN_MEMORY_SCOPE=local
# 已有凭据时可代替扫码保存的文件：
# ORANGE_WEIXIN_ACCOUNT_ID=
# ORANGE_WEIXIN_TOKEN=
